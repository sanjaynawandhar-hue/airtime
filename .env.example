# ---------------------------------------------------------------------------
# Airtime — copy to .env.local and fill in. Never commit .env.local.
# Every one of these is read only in src/lib/core/config.ts, which is
# `server-only`, so none of them can reach the client bundle.
# ---------------------------------------------------------------------------

# TMDB — https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (the long v4 JWT), NOT the v3 api_key.
TMDB_READ_TOKEN=

# OMDb — https://www.omdbapi.com/apikey.aspx
# Free tier is 1,000 requests/day. The $1/mo Patreon tier gives 100,000/day and
# is worth it: the critics leaderboard alone costs ~200 lookups per rebuild.
OMDB_API_KEY=

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Create a project, enable the API, then Credentials -> Create API key.
YOUTUBE_API_KEY=

# Last.fm — https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Neon Postgres — https://console.neon.tech
# Use the POOLED connection string (host contains "-pooler").
DATABASE_URL=

# Gaana has no public API. Leave this unset. See src/lib/providers/gaana.ts.
GAANA_ENABLED=false
